# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Pilih salah satu autentikasi AI. Google direct diprioritaskan jika keduanya ada.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
GOOGLE_AI_MODEL=gemini-3.5-flash-lite

# Alternatif: Vercel AI Gateway.
AI_GATEWAY_API_KEY=your-ai-gateway-key
AI_MODEL=google/gemini-3.5-flash-lite

# Rahasia untuk endpoint cleanup yang dipanggil Vercel Cron setiap hari.
CRON_SECRET=replace-with-a-long-random-secret
